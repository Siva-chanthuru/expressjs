<h2 class="mb-3">house List</h2>

<a href="/houses/create" class="btn btn-primary mb-3">
    Add New House
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>House Name</th>
            <th>Colour</th>
            <th width="220">Action</th>
        </tr>
    </thead>

    <tbody>

        <% if(houses.length > 0){ %>

            <% houses.forEach(function(house){ %>

                <tr>

                    <td><%= house.id %></td>
                    <td><%= house.house_name %></td>
                    <td><%= house.colour %></td>

                    <td>

                        <a href="/houses/<%= house.id %>/show"
                           class="btn btn-info btn-sm">
                            👁 View
                        </a>

                        <a href="/houses/<%= house.id %>/edit"
                           class="btn btn-warning btn-sm">
                            🖊 Edit
                        </a>

                        <form action="/houses/<%= house.id %>?_method=DELETE"
                              method="POST"
                              style="display:inline;"
                              onsubmit="return confirm('Are you sure you want to delete this house?');">

                            <button class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this house?');">
                               🗑 Delete
                            </button>

                        </form>

                    </td>

                </tr>

            <% }) %>

        <% } else { %>

            <tr>
                <td colspan="6" class="text-center">
                    No House Found
                </td>
            </tr>

        <% } %>

    </tbody>

</table>