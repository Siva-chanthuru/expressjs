<div class="container mt-4">

    <h2 class="mb-4">House Details</h2>

    <table class="table table-bordered">

        <tr>
            <th width="200">ID</th>
            <td><%= house.id %></td>
        </tr>

        <tr>
            <th>House Name</th>
            <td><%= house.house_name %></td>
        </tr>

        <tr>
            <th>House Color</th>
            <td><%= house.house_color %></td>
        </tr>

    </table>

    <a href="/houses" class="btn btn-secondary">
        Back
    </a>

    <a href="/houses/<%= house.id %>/edit" class="btn btn-warning">
        Edit
    </a>

</div>