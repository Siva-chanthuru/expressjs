<div class="container mt-4">

    <h2 class="mb-4">Edit House</h2>

    <form action="/houses/<%= house.id %>?_method=PUT" method="POST">

        <div class="mb-3">
            <label class="form-label">House Name</label>
            <input type="text"
                   name="house_name"
                   class="form-control"
                   value="<%= house.house_name %>"
        </div>

        <div class="mb-3">
            <label class="form-label">House Color</label>
            <input type="text"
                   name="colour"
                   class="form-control"
                   value="<%= house.colour %>"
                
        </div>

        <button type="submit" class="btn btn-success">
            Update
        </button>

        <a href="/houses" class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>
