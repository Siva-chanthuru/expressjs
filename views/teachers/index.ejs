<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Teachers</h2>

        <a href="/teacher/create" class="btn btn-primary">
            + Add Teacher
        </a>
    </div>

    <table class="table table-bordered table-striped table-hover">

        <thead class="table-dark">

            <tr>
                <th>ID</th>
                <th>Reg. No</th>
                <th>NIC</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Gender</th>
                <th>Mobile</th>
                <th width="220">Action</th>
            </tr>

        </thead>

        <tbody>

            <% if (teachers.length > 0) { %>

                <% teachers.forEach(function(teacher){ %>

                    <tr>

                        <td><%= teacher.id %></td>
                        <td><%= teacher.registration_number %></td>
                        <td><%= teacher.nic_number %></td>
                        <td><%= teacher.first_name %></td>
                        <td><%= teacher.last_name %></td>
                        <td><%= teacher.gender %></td>
                        <td><%= teacher.mobile_number %></td>

                        <td>

                            <a href="/teacher/<%= teacher.id %>/show" class="btn btn-info btn-sm">
                                👁 View
                            </a>

                            <a href="/teacher/<%= teacher.id %>/edit" class="btn btn-warning btn-sm">
                                ✏ Edit
                            </a>

                            <form action="/teacher/<%= teacher.id %>?_method=DELETE"
                                  method="POST"
                                  style="display:inline;">

                                <button
                                    type="submit"
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('Are you sure you want to delete this teacher?')">

                                    🗑 Delete

                                </button>

                            </form>

                        </td>

                    </tr>

                <% }) %>

            <% } else { %>

                <tr>

                    <td colspan="8" class="text-center text-danger">
                        No Teachers Found
                    </td>

                </tr>

            <% } %>

        </tbody>

    </table>

</div>