<h1>
    <%= title %>
</h1>

<a href="/families/create" class="btn btn-success">New Family</a>
<table border="1" cellpadding="5" cellspacing="0" style="border-collapse: collapse; width: 100%;">

    
    <thead>
        <tr>
            <th>Mobile Number</th>
            <th>Father's Name</th>
            <th>Mother's Name</th>
            <th>Father's NIC Number</th>
            <th>Mother's NIC Number</th>
            <th>Father's Job</th>
            <th>Mother's Job</th>
            <th>Residential Address</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        <% families.forEach((family)=> { %>
            <tr>
                <td>
                    <%= family.mobile_number %>
                </td>
                <td>
                    <%= family.fa_first_name %>
                </td>
                <td>
                    <%= family.mo_first_name %>
                </td>
                <td>
                    <%= family.fa_nic_number %>
                </td>
                <td>
                    <%= family.mo_nic_number %>
                </td>
                <td>
                    <%= family.fa_job %>
                </td>
                <td>
                    <%= family.mo_job %>
                </td>
                <td>
                    <%= family.residential_address %>
                </td>
            
                <td>
                      <a href="/families/<%= family.id %>/show" class="btn btn-primary">👁 View</a>
                         <a href="/families/<%= family.id %>/edit" class="btn btn-warning">🖊 Edit</a>
                    <form action="/families/<%= family.id %>?_method=DELETE" method="POST" style="display: inline;">
                        <button type="submit" class="btn btn-danger" onclick="return confirm('⚠️ This action cannot be undone.\n\nAre you sure you want to delete this family?');">
                            🗑 Delete
                        </button>
                    </form>
                </td>
            </tr>
            <% }); %>
    </tbody>
</table>