<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Families</h2>

        <a href="/family/create" class="btn btn-primary">
            + Add Family
        </a>
    </div>

    <table class="table table-bordered table-striped table-hover">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Mobile No</th>
                <th>Father First Name</th>
                <th>Mother First Name</th>
                <th>Father Job</th>
                <th>Mother Job</th>
                <th>Father NIC</th>
                <th>Mother NIC</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>

            <% if (families.length > 0) { %>

                <% families.forEach(function(family) { %>

                    <tr>


                        <td><%= family.id %></td>

                        <td><%= family.mobile_number %></td>

                        <td><%= family.fa_first_name %></td>

                        <td><%= family.mo_first_name %></td>

                        <td><%= family.fa_job %></td>

                        <td><%= family.mo_job %></td>

                        <td><%= family.fa_nic_number %></td>

                        <td><%= family.mo_nic_number %></td>

                        <td>

                            <a href="/families/<%= family.id %>/show"
                               class="btn btn-info btn-sm">
                                👁 View
                            </a>

                            <a href="/families/<%= family.id %>/edit"
                               class="btn btn-warning btn-sm">
                                ✏ Edit
                            </a>

                            <form action="/families/<%= family.id %>?_method=DELETE"
                                  method="POST"
                                  style="display:inline;">

                                <button
                                    type="submit"
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('Are you sure you want to delete this family?')">

                                    🗑 Delete

                                </button>

                            </form>

                        </td>

                    </tr>

                <% }) %>

            <% } else { %>

                <tr>
                    <td colspan="10" class="text-center text-danger">
                        No Families Found
                    </td>
                </tr>

            <% } %>

        </tbody>

    </table>

</div>
