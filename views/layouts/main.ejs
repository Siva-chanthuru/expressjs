<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

    <style>
        .container {
            background-color: #118cd2;
        }

        .header {
            background-color: #a8bccd;
            color: white;
            padding: 10px;
            text-align: center;
        }

        .footer {
            background-color: #7779ef;
            color: white;
            padding: 10px;
            text-align: center;
        }
    </style>
</head>

<body>
    <table border="1" cellpadding="5" cellspacing="0" style="border-collapse: collapse; width: 100%;">
        <tr class="header" height="100">
            <td colspan="2">
                <h1>
                    <%= title %>
                </h1>
            </td>
        </tr>
        <tr height="400">
            <td width="20%">
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/student">Student</a></li>
                    <li><a href="/student/10/show">Student 10</a></li>
                    <li><a href="/student/create">Create Student</a></li>
                </ul>
            </td>
            <td class="content">

                <%- body %>

            </td>
        </tr>
        <tr height="100" class="footer">
            <td colspan="2">Footer</td>
        </tr>

    </table>

</body>

</html>