<h1>
    <%= title %>
</h1>
<p>
    <%= message %>
</p>
<a href="/student/create" class="btn btn-success">New Student</a>
<table border="1" cellpadding="5" cellspacing="0" style="border-collapse: collapse; width: 100%;">
    <thead>
        <tr>
            <th>Admission No</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        <% students.forEach((student)=> { %>
            <tr>
                <td>
                    <%= student.admission_number %>
                </td>
                <td>
                    <%= student.first_name %>
                </td>
                <td>
                    <%= student.last_name %>
                </td>
                <td>
                      <a href="/student/<%= student.id %>/show" class="btn btn-primary">View</a>
                         <a href="/student/<%= student.id %>/edit" class="btn btn-warning">Edit</a>
                    <form action="/student/<%= student.id %>?_method=DELETE" method="POST" style="display: inline;">
                        <button type="submit" class="btn btn-danger" onclick="return confirm('⚠️ This action cannot be undone.\n\nAre you sure you want to delete this student?');">
                            🗑 Delete
                        </button>
                    </form>
                </td>
            </tr>
            <% }); %>
    </tbody>
</table>