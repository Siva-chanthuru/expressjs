<h1>Edit Student</h1>
<h3>
    <%= student.first_name %>
        <%= student.last_name %>'S Information
</h3>
</h3>
<form action="/student/<%= student.id %>?_method=PUT" method="POST">
    <label for="admission_number">Admission No</label>

    <input type="number" id="admission_number" name="admission_number" value="<%= student.admission_number %>" required
        readonly>
    <br>
    <label for="first_name">First Name</label>
    <input type="text" id="first_name" name="first_name" value="<%= student.first_name %>" required>
    <br>
    <label for="last_name">Last Name</label>
    <input type="text" id="last_name" name="last_name" value="<%= student.last_name %>" required>
    <br>
    <input type="submit" value="Submit">
</form>