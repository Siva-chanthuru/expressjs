<div class="px-4 py-8 sm:px-6 lg:px-8">

    <h1 class="text-3xl font-bold text-red-500">
    Edit Student
</h1>
     <form action="/student/<%= student.id %>?_method=PUT" method="POST"></form>

    <form class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">

        <div>
            <label class="block text-sm font-medium text-black">
                Admission No
            </label>

            <input type="text"
                   Name="admission_number"
                   value="<%= student.admission_number %>"
                   class="mt-2 block w-full rounded-md border border-gray-600 bg-gray-800 px-3 py-2 text-white">
        </div>

        <div>
            <label class="block text-sm font-medium text-black">
                First Name
            </label>

            <input type="text"
                   Name="student_first_name"
                   value="<%= student.first_name %>"
                   class="mt-2 block w-full rounded-md border border-gray-600 bg-gray-800 px-3 py-2 text-white">
        </div>

        <div>
            <label class="block text-sm font-medium text-black">
                Last Name
            </label>

            <input type="text"
                   Name="student_last_name"
                   value="<%= student.last_name %>"
                   class="mt-2 block w-full rounded-md border border-gray-600 bg-gray-800 px-3 py-2 text-white">
        </div>

        <div>
            <label class="block text-sm font-medium text-black">
                Gender
            </label>

            <select Name="student_gender" class="mt-2 block w-full rounded-md border border-gray-600 bg-gray-800 px-3 py-2 text-white">
                <option>Male</option>
                <option>Female</option>
            </select>
        </div>

            <div>
            <label class="block text-sm font-medium text-black">
                Nic Number
            </label>

            <input type="text"
                   Name="student_nic_number"
                   value="<%= student.nic_number %>"
                   class="mt-2 block w-full rounded-md border border-gray-600 bg-gray-800 px-3 py-2 text-white">
        </div>

            <div>
            <label class="block text-sm font-medium text-black">
                Date of Birth
            </label>

            <input type="text"
                   Name="student_date_of_birth"
                   value="<%= student.date_of_birth %>"
                   class="mt-2 block w-full rounded-md border border-gray-600 bg-gray-800 px-3 py-2 text-white">
        </div>

            <div>
            <label class="block text-sm font-medium text-black">
                Birth Certificate Number
            </label>

            <input type="text"
                   Name="student_birth_certificate_number"
                   value="<%= student.birth_certificate_number %>"
                   class="mt-2 block w-full rounded-md border border-gray-600 bg-gray-800 px-3 py-2 text-white">
        </div>

            <div>
            <label class="block text-sm font-medium text-black">
                Telephone Number
            </label>

            <input type="text"
                   Name="student_telephone_number"
                   value="<%= student.telephone_number %>"
                   class="mt-2 block w-full rounded-md border border-gray-600 bg-gray-800 px-3 py-2 text-white">
        </div>

            <div>
            <label class="block text-sm font-medium text-black">
                House ID
            </label>

            <input type="text"
                   Name="student_house_id"
                   value="<%= student.house_id %>"
                   class="mt-2 block w-full rounded-md border border-gray-600 bg-gray-800 px-3 py-2 text-white">
        </div>

            <div>
            <label class="block text-sm font-medium text-black">
                Grade ID
            </label>

            <input type="text"
                   Name="student_grade_id"
                   value="<%= student.grade_id %>"
                   class="mt-2 block w-full rounded-md border border-gray-600 bg-gray-800 px-3 py-2 text-white">
        </div>

            <div>
            <label class="block text-sm font-medium text-black">
                Medium
            </label>

            <input type="text"
                   Name="student_medium"
                   value="<%= student.medium %>"
                   class="mt-2 block w-full rounded-md border border-gray-600 bg-gray-800 px-3 py-2 text-white">
        </div>

            <div>
            <label class="block text-sm font-medium text-black">
                Date of Admission
            </label>

            <input type="text"
                   Name="student_date_of_admission"
                   value="<%= student.date_of_admission %>"
                   class="mt-2 block w-full rounded-md border border-gray-600 bg-gray-800 px-3 py-2 text-white">
        </div>

            <div>
            <label class="block text-sm font-medium text-black">
                Permanent Address
            </label>

            <input type="text"
                   Name="student_permanent_address"
                   value="<%= student.per_address %>"
                   class="mt-2 block w-full rounded-md border border-gray-600 bg-gray-800 px-3 py-2 text-white">
        </div>

        

        <div class="sm:col-span-2 flex mt-4">

            <button type="submit"
                    class="rounded-md bg-indigo-500 px-5 py-2.5 text-sm font-semibold text-Green hover:bg-indigo-400">
                Update
            </button>

            <a href="/student"
               class="rounded-md bg-gray-600 px-5 py-2.5 text-sm font-semibold text-Red hover:bg-gray-500">
                Cancel
            </a>

        </div>

    </form>

</div>


