<form action="/subjects" method="POST" class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">

  <!-- Subject Name -->
  <div class="sm:col-span-3">
    <label for="subject_name"
           class="block text-sm/6 font-medium text-gray-900">
      Subject Name
    </label>

    <div class="mt-2">
      <input type="text"
             id="subject_name"
             name="subject_name"
             required
             class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6">
    </div>
  </div>


  <!-- Subject Index -->
  <div class="sm:col-span-3">
    <label for="subject_index"
           class="block text-sm/6 font-medium text-gray-900">
      Subject Index
    </label>

    <div class="mt-2">
      <input type="text"
             id="subject_index"
             name="subject_index"
             required
             class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6">
    </div>
  </div>


  <!-- Last Name -->
  <div class="sm:col-span-3">
    <label for="subject_order"
           class="block text-sm/6 font-medium text-gray-900">
      Subject Order
    </label>

    <div class="mt-2">
      <input type="number"
             id="subject_order"
             name="subject_order"
             required
             class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6">
    </div>
  </div>


  <!-- DOB -->
  <div class="sm:col-span-3">
    <label for="dob"
           class="block text-sm/6 font-medium text-gray-900">
     Subject Number
    </label>

    <div class="mt-2">
      <input type="text"
             id="subject_number"
             name="subject_number"
             class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6">
    </div>
  </div>


    <div class="sm:col-span-3">
    <label for="nic_number"
           class="block text-sm/6 font-medium text-gray-900">
      Colour
    </label>

    <div class="mt-2">
      <input type="text"
             id="colour"
             name="colour"
             class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6">
    </div>
  </div>


  <!-- Button -->
  <div class="sm:col-span-6 mt-3">
    <button type="submit"
    style="background-color: green; color: white; padding: 10px 20px; border-radius: 6px;">
    Create Student
</button>
  </div>

</form>
