<form action="/subject" method="POST" class="row g-3">

  <div class="col-md-6">
    <label class="form-label">subject Name</label>
    <input type="text"
           class="form-control"
           name="subject_name"
           required>
  </div>

  <div class="col-md-6">
    <label class="form-label">subject index</label>
    <input type="text"
           class="form-control"
           name="subject_index"
           required>
  </div>

  <div class="col-md-6">
    <label class="form-label">subject order</label>
    <input type="text"
           class="form-control"
           name="subject_order"
           required>
  </div>

  <div class="col-6">
    <label class="form-label">subject number</label>
    <input type="text"
           class="form-control"
           name="subject_number"
           required>
  </div>

  <div class="col-6">
    <label class="form-label">colour</label>
    <input type="text"
           class="form-control"
           name="color"
           required>
  </div>

  <div class="col-12">
    <button type="submit" class="btn btn-success">
      Create Subject
    </button>
  </div>

</form>