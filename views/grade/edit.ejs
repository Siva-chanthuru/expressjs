<div class="px-4 py-8 sm:px-6 lg:px-8">

    <h1 class="text-3xl font-bold text-red-500">
    Edit Grade
</h1>
     <form action="/grade/<%= grade.id %>?_method=PUT" method="POST"></form>

    <form class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">

        <div>
            <label class="block text-sm font-medium text-black">
                Grade Name
            </label>

            <input type="text"
                   Name="grade_name"
                   value="<%= grade.name %>"
                   class="mt-2 block w-full rounded-md border border-gray-600 bg-gray-800 px-3 py-2 text-white">
        </div>

        <div>
            <label class="block text-sm font-medium text-black">
                Grade Group
            </label>

            <input type="text"
                   Name="grade_group"
                   value="<%= grade.group %>"
                   class="mt-2 block w-full rounded-md border border-gray-600 bg-gray-800 px-3 py-2 text-white">
        </div>

        <div>
            <label class="block text-sm font-medium text-black">
                Grade Order
            </label>

            <input type="text"
                   Name="grade_order"
                   value="<%= grade.order %>"
                   class="mt-2 block w-full rounded-md border border-gray-600 bg-gray-800 px-3 py-2 text-white">
        </div>

        <div>
            <label class="block text-sm font-medium text-black">
                Colour
            </label>

            <input type="text"
                   Name="colour"
                   value="<%= grade.colour %>"
                   class="mt-2 block w-full rounded-md border border-gray-600 bg-gray-800 px-3 py-2 text-white">
        </div>

      
        

        <div class="sm:col-span-2 flex mt-4">

            <button type="submit"
                    class="rounded-md bg-indigo-500 px-5 py-2.5 text-sm font-semibold text-Green hover:bg-indigo-400">
                Update
            </button>

            <a href="/grade"
               class="rounded-md bg-gray-600 px-5 py-2.5 text-sm font-semibold text-Red hover:bg-gray-500">
                Cancel
            </a>

        </div>

    </form>