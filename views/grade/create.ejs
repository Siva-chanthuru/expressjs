<form action="/grade" method="POST" class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">

  <!-- Grade Name -->
  <div class="sm:col-span-3">
    <label for="grade_name"
           class="block text-sm/6 font-medium text-gray-900">
      Grade Name
    </label>

    <div class="mt-2">
      <input type="text"
             id="grade_name"
             name="grade_name"
             required
             class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6">
    </div>
  </div>


  <!-- Grade Group -->
  <div class="sm:col-span-3">
    <label for="grade_group"
           class="block text-sm/6 font-medium text-gray-900">
      Grade Group
    </label>

    <div class="mt-2">
      <input type="text"
             id="grade_group"
             name="grade_group"
             required
             class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6">
    </div>
  </div>


  <!-- Grade Order -->
  <div class="sm:col-span-3">
    <label for="grade_order"
           class="block text-sm/6 font-medium text-gray-900">
      Grade Order
    </label>

    <div class="mt-2">
      <input type="number"
             id="grade_order"
             name="grade_order"
             required
             class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6">
    </div>
  </div>


  <!-- DOB -->
  <div class="sm:col-span-3">
    <label for="dob"
           class="block text-sm/6 font-medium text-gray-900">
      Color
    </label>

    <div class="mt-2">
      <input type="color"
             id="colour"
             name="colour"
             class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6">
    </div>
  </div>


  <!-- Button -->
  <div class="sm:col-span-6 mt-3">
    <button type="submit"
    style="background-color: green; color: white; padding: 10px 20px; border-radius: 6px;">
    Create Grade
</button>
  </div>

</form>



