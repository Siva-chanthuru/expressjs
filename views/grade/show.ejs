<div class="container mt-4">

    <h2 class="mb-4">Grade Details</h2>

    <table class="table table-bordered">

        <tr>
            <th width="200">ID</th>
            <td><%= grade.id %></td>
        </tr>

        <tr>
            <th>Grade Name</th>
            <td><%= grade.grade_name %></td>
        </tr>

        <tr>
            <th>Grade Group</th>
            <td><%= grade.grade_group %></td>
        </tr>

        <tr>
            <th>Grade Order</th>
            <td><%= grade.grade_order %></td>
        </tr>

        <tr>
            <th>Colour</th>
            <td><%= grade.colour %></td>
        </tr>

    </table>

    <a href="/grade" class="btn btn-secondary">
        Back
    </a>

    <a href="/grade/<%= grade.id %>/edit" class="btn btn-warning">
        Edit
    </a>

</div>