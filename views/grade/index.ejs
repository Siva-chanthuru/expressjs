<h2 class="mb-3">Grade List</h2>

<a href="/grade/create" class="btn btn-primary mb-3">
    Add New Grade
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Grade Name</th>
            <th>Grade Group</th>
            <th>Grade Order</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        <% if(grades.length > 0){ %>

            <% grades.forEach(function(grade){ %>

                <tr>

                    <td><%= grade.id %></td>
                    <td><%= grade.grade_name %></td>
                    <td><%= grade.grade_group %></td>
                    <td><%= grade.grade_order %></td>

                    <td>

                        <a href="/grade/<%= grade.id %>/show"
                           class="btn btn-info btn-sm">
                            👁 View
                        </a>

                        <a href="/grade/<%= grade.id %>/edit"
                           class="btn btn-warning btn-sm">
                            🖊 Edit
                        </a>

                        <form action="/grade/<%= grade.id %>?_method=DELETE"
                              method="POST"
                              style="display:inline;"
                              onsubmit="return confirm('Are you sure you want to delete this grade?');">

                            <button class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this grade?');">
                               🗑 Delete
                            </button>

                        </form>

                    </td>

                </tr>

            <% }) %>

        <% } else { %>

            <tr>
                <td colspan="6" class="text-center">
                    No Grade Found
                </td>
            </tr>

        <% } %>

    </tbody>

</table>